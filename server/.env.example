# Copy this file to .env and replace the placeholder.
# Generate a key with: openssl rand -base64 32
# Keep the key backed up separately: without it, encrypted provider API keys
# cannot be decrypted after a restore.

REINCHAT_MASTER_KEY=REPLACE_WITH_OPENSSL_RAND_BASE64_32
REINCHAT_TOKEN_TTL_HOURS=720
# Optional. If empty, /api/admin/* and the /admin console are disabled.
REINCHAT_ADMIN_TOKEN=REPLACE_WITH_A_LONG_RANDOM_ADMIN_TOKEN
